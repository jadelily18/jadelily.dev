{
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"js/ts.preferences.importModuleSpecifierEnding": "minimal",
	"js/ts.preferences.autoImportSpecifierExcludeRegexes": [
		"^\\$lib/shadcn/components/ui"
	],
	"tailwindCSS.classAttributes": [
		"class",
		"className",
		"ngClass",
		"class:list",
		".*Styles.*"
	]
}
