{
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"typescript.preferences.autoImportSpecifierExcludeRegexes": [
		"^\\$lib/shadcn/components/ui"
	],
	"javascript.preferences.autoImportSpecifierExcludeRegexes": [
		"^\\$lib/shadcn/components/ui"
	],
	"tailwindCSS.classAttributes": [
		"class",
		"className",
		"ngClass",
		"class:list",
		".*Styles.*"
	]
}
